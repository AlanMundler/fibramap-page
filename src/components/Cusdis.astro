---
interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;
const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID;
const host = "https://cusdis.com";
---

<div
  id="cusdis_thread"
  data-host={host}
  data-app-id={appId}
  data-page-id={pageId}
  data-page-url={pageUrl}
  data-page-title={pageTitle}
  data-theme="dark"
></div>

<script is:inline define:vars={{ host }}>
  function initCusdis() {
    const el = document.getElementById('cusdis_thread');
    if (!el) return;
    if (typeof window.CUSDIS !== 'undefined') {
      window.CUSDIS.renderTo(el);
    } else {
      const s = document.createElement('script');
      s.src = `${host}/js/cusdis.es.js`;
      s.async = true;
      s.onload = () => { if (typeof window.CUSDIS !== 'undefined') window.CUSDIS.renderTo(el); };
      document.head.appendChild(s);
    }
  }
  document.addEventListener('astro:page-load', initCusdis);
  initCusdis();
</script>
