---
import { SITE_BASE as base } from '../data/constants';
const raw = Astro.url.pathname.replace(base, '') || '/';
const currentPath = raw.endsWith('/') && raw !== '/' ? raw.slice(0, -1) : raw;

const isAnyActive = (hrefs) => hrefs.some(h => currentPath === h);

const groups = [
  { label: 'Inicio', href: '/' },
  {
    label: 'Proveedores',
    active: isAnyActive(['/provider', '/map']),
    items: [
      { href: '/provider', label: 'Planes y precios' },
      { href: '/map', label: 'Mapa de cobertura' },
    ],
  },
  {
    label: 'Herramientas',
    active: isAnyActive(['/compare', '/calculadora', '/velocidad', '/leaderboard', '/quiz']),
    items: [
      { href: '/quiz', label: '¿Qué plan me conviene?' },
      { href: '/compare', label: 'Comparar planes' },
      { href: '/calculadora', label: 'Costo real' },
      { href: '/velocidad', label: 'Test de velocidad' },
      { href: '/leaderboard', label: 'Leaderboard' },
    ],
  },
  {
    label: 'Info',
    active: isAnyActive(['/review', '/promo']),
    items: [
      { href: '/review', label: 'Opiniones' },
      { href: '/promo', label: 'Promociones' },
    ],
  },
  {
    label: 'Ayuda',
    active: isAnyActive(['/blog', '/enacom', '/checklist']),
    items: [
      { href: '/blog', label: 'Noticias' },
      { href: '/enacom', label: 'Guía ENACOM' },
      { href: '/checklist', label: 'Checklist' },
    ],
  },
];
---
<nav class="sticky top-0 z-50 bg-gray-800/95 backdrop-blur-md border-b border-gray-700/50 shadow-lg shadow-gray-900/30">
  <div class="max-w-4xl mx-auto px-4 flex items-center h-14 gap-6">
    <a href={base + '/'} class="text-lg font-bold text-white tracking-tight shrink-0 hover:opacity-80 transition-opacity">
      Fibra<span class="text-blue-400">Map</span>
    </a>

    <div class="hidden sm:flex items-center gap-1 flex-1">
      {groups.map(group => {
        if (group.href) {
          const isActive = currentPath === group.href;
          return (
            <a
              href={base + group.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                "px-3 py-1.5 text-sm rounded-lg font-normal transition-colors duration-150",
                isActive
                  ? "bg-blue-600 text-white shadow-md shadow-blue-500/20 pointer-events-none"
                  : "text-gray-400 hover:text-white hover:bg-gray-700/50",
              ]}
            >
              {group.label}
            </a>
          );
        }
        return (
          <div class="relative group">
            <button
              type="button"
              class:list={[
                "px-3 py-1.5 text-sm rounded-lg font-normal transition-colors duration-150 flex items-center gap-1",
                group.active
                  ? "bg-blue-600/20 text-blue-400"
                  : "text-gray-400 hover:text-white hover:bg-gray-700/50",
              ]}
            >
              {group.label}
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50">
              <div class="bg-gray-800 border border-gray-700/50 rounded-xl shadow-xl shadow-gray-900/50 py-1.5 min-w-[180px]">
                {group.items.map(item => {
                  const isActive = currentPath === item.href;
                  return (
                    <a
                      href={base + item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class:list={[
                        "block px-4 py-2 text-sm transition-colors duration-150",
                        isActive
                          ? "text-blue-400 bg-blue-500/10 font-medium"
                          : "text-gray-300 hover:text-white hover:bg-gray-700/50",
                      ]}
                    >
                      {item.label}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <button id="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" class="sm:hidden ml-auto p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-gray-700/50 transition-colors duration-150">
      <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden sm:hidden border-t border-gray-700/50 bg-gray-800/95 backdrop-blur-md">
    <div class="max-w-4xl mx-auto px-4 py-2 space-y-0.5">
      {groups.map(group => {
        if (group.href) {
          const isActive = currentPath === group.href;
          return (
            <a
              href={base + group.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                "block px-3 py-2 text-sm rounded-lg transition-colors duration-150",
                isActive
                  ? "bg-blue-600 text-white font-medium shadow-md shadow-blue-500/20"
                  : "text-gray-400 hover:text-white hover:bg-gray-700/50",
              ]}
            >
              {group.label}
            </a>
          );
        }
        return (
          <div class="mobile-group">
            <button
              type="button"
              data-group={group.label}
              class:list={[
                "mobile-group-toggle w-full flex items-center justify-between px-3 py-2 text-sm rounded-lg transition-colors duration-150",
                group.active
                  ? "text-blue-400 bg-blue-500/10"
                  : "text-gray-400 hover:text-white hover:bg-gray-700/50",
              ]}
            >
              {group.label}
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="mobile-group-items hidden pl-4 space-y-0.5">
              {group.items.map(item => {
                const isActive = currentPath === item.href;
                return (
                  <a
                    href={base + item.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      "block px-3 py-2 text-sm rounded-lg transition-colors duration-150",
                      isActive
                        ? "bg-blue-600 text-white font-medium shadow-md shadow-blue-500/20"
                        : "text-gray-400 hover:text-white hover:bg-gray-700/50",
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('click', (e) => {
    const toggle = e.target.closest('#menu-toggle');
    if (toggle) {
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      if (!menu) return;
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      iconOpen?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
      return;
    }

    const groupToggle = e.target.closest('.mobile-group-toggle');
    if (groupToggle) {
      const items = groupToggle.nextElementSibling;
      const arrow = groupToggle.querySelector('svg');
      if (items) {
        items.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
      }
    }
  });

  document.addEventListener('astro:after-swap', () => {
    const m = document.getElementById('mobile-menu');
    const o = document.getElementById('menu-icon-open');
    const c = document.getElementById('menu-icon-close');
    m?.classList.add('hidden');
    o?.classList.remove('hidden');
    c?.classList.add('hidden');
  });
</script>
