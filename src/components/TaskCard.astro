---
interface Props {
  servicio: {
    id: string;
    proveedor: string;
    plan: string;
    velocidad: string;
    velocidadSub: string;
    velocidadBaj: string;
    tecnologia: string;
    ip: string;
    instalacion: string;
    precioLista: string;
    precioDesc: string;
    precioDetalle?: string;
    atencionCl: string;
    descripcion: string;
    destacado?: boolean;
  };
}
const { servicio: s } = Astro.props;

const campos = [
  ['Velocidad', s.velocidad],
  ['Subida', s.velocidadSub],
  ['Bajada', s.velocidadBaj],
  ['Tecnología', s.tecnologia],
  ['IP', s.ip],
  ['Instalación', s.instalacion],
  ['Precio lista', s.precioLista],
  ['Precio promo', s.precioDesc],
  ['Atención', s.atencionCl],
];
---

<div class:list={[
  "rounded-lg p-4 transition-shadow",
  s.destacado
    ? "bg-blue-950/30 ring-1 ring-blue-800"
    : "bg-gray-800 hover:shadow-md"
]}>
  <div class="flex items-start justify-between gap-2 mb-3">
    <div>
      <h3 class="font-semibold text-lg">{s.plan}</h3>
      <p class="text-sm text-gray-400">{s.descripcion}</p>
    </div>
    {s.destacado && (
      <span class="shrink-0 text-xs font-medium bg-blue-900 text-blue-300 px-2 py-0.5 rounded-full">Popular</span>
    )}
  </div>

  <dl class="space-y-1 text-sm">
    {campos.map(([label, value]) => value && (
      <div class="flex justify-between gap-2">
        <dt class="text-gray-400 shrink-0">{label}</dt>
        <dd class="text-right font-medium">{value}</dd>
      </div>
    ))}
  </dl>

  {s.precioDetalle && (
    <p class="mt-3 text-xs text-gray-500 border-t border-gray-700 pt-2">{s.precioDetalle}</p>
  )}
</div>
