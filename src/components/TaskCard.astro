---
interface Props {
  servicio: {
    id: string;
    proveedor: string;
    plan: string;
    velocidad: string;
    velocidadSub: string;
    velocidadBaj: string;
    tecnologia: string;
    ip: string;
    instalacion: string;
    precioLista: string;
    precioDesc: string;
    precioDetalle?: string;
    atencionCl: string;
    descripcion: string;
    destacado?: boolean;
  };
}
const { servicio: s } = Astro.props;

const campos = [
  ['Velocidad', s.velocidad],
  ['Subida', s.velocidadSub],
  ['Bajada', s.velocidadBaj],
  ['Tecnología', s.tecnologia],
  ['IP', s.ip],
  ['Instalación', s.instalacion],
  ['Precio lista', s.precioLista],
  ['Precio promo', s.precioDesc],
  ['Atención', s.atencionCl],
];
---

<div class:list={[
  "rounded-xl p-4 sm:p-5 backdrop-blur-sm transition-all duration-200 flex flex-col h-full",
  s.destacado
    ? "bg-blue-950/30 border border-blue-800/50 hover:border-blue-700/60 shadow-lg shadow-blue-900/20"
    : "bg-gray-800/80 border border-gray-700/50 hover:border-gray-600 hover:shadow-xl hover:shadow-gray-900/30"
]}>
  <div class="flex items-start justify-between gap-2 mb-3">
    <div class="min-w-0 flex-1">
      <h3 class="font-semibold text-base sm:text-lg text-white truncate">{s.plan}</h3>
      <p class="text-xs sm:text-sm text-gray-400 mt-0.5 line-clamp-2 h-8 sm:h-9">{s.descripcion}</p>
    </div>
    {s.destacado && (
      <span class="shrink-0 text-[10px] sm:text-xs font-medium bg-blue-500/15 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded-full">Popular</span>
    )}
  </div>

  <dl class="space-y-1.5 text-xs sm:text-sm flex-1">
    {campos.map(([label, value]) => value && (
      <div class="flex justify-between gap-2 items-baseline">
        <dt class="text-gray-400 shrink-0">{label}</dt>
        <dd class="text-right font-medium text-gray-200 min-w-0 break-words">{value}</dd>
      </div>
    ))}
  </dl>

  {s.precioDetalle && (
    <p class="mt-auto text-[10px] sm:text-xs text-gray-500 border-t border-gray-700/50 pt-2.5 leading-relaxed">{s.precioDetalle}</p>
  )}
</div>
