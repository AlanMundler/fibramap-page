---
interface Props {
  servicio: {
    id: number;
    proveedor: string;
    plan?: string;
    velocidad?: string;
    velocidadSub?: string;
    velocidadBaj?: string;
    tecnologia?: string;
    ip?: string;
    instalacion?: string;
    precioLista?: string;
    precioDesc?: string;
    atencionCl?: string;
    descripcion?: string;
  };
}
const { servicio: s } = Astro.props;
const campos = [
  ['Plan', s.plan],
  ['Velocidad', s.velocidad],
  ['Subida', s.velocidadSub],
  ['Bajada', s.velocidadBaj],
  ['Tecnología', s.tecnologia],
  ['IP', s.ip],
  ['Instalación', s.instalacion],
  ['Precio lista', s.precioLista],
  ['Precio c/descuento', s.precioDesc],
  ['Atención al cliente', s.atencionCl],
  ['Descripción', s.descripcion],
];
---

<div class="bg-white dark:bg-gray-800 rounded-lg p-4 hover:shadow-md transition-shadow">
  <h2 class="font-semibold text-lg mb-3">{s.proveedor}</h2>
  <dl class="space-y-1 text-sm">
    {campos.map(([label, value]) => value && (
      <div class="flex justify-between gap-2">
        <dt class="text-gray-500 dark:text-gray-400 shrink-0">{label}</dt>
        <dd class="text-right font-medium">{value}</dd>
      </div>
    ))}
  </dl>
</div>
