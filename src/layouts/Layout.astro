---
import NavBar from '../components/NavBar.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Fibra optica en Cordoba, Argentina' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/fibramap-page/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="bg-gray-100 dark:bg-gray-900 min-h-screen text-gray-900 dark:text-white">
    <NavBar />
    <main class="pt-4 pb-8 sm:ml-56 min-h-screen">
      <slot />
    </main>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
