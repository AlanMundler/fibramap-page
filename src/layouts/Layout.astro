---
import NavBar from '../components/NavBar.astro';
import { ViewTransitions } from 'astro:transitions';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Fibra optica en Cordoba, Argentina' } = Astro.props;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/fibramap-page/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-gray-900 min-h-screen text-gray-100 flex flex-col">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">Ir al contenido</a>
    <NavBar />
    <main id="content" class="flex-1 py-6 sm:py-8 px-4 sm:px-6 max-w-4xl mx-auto w-full">
      <slot />
    </main>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
