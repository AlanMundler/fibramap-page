---
import NavBar from '../components/NavBar.astro';
import { ViewTransitions } from 'astro:transitions';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Fibra optica en Cordoba, Argentina' } = Astro.props;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/fibramap-page/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-gray-900 min-h-screen text-gray-100">
    <NavBar />
    <main class="py-6 px-4 min-h-screen max-w-5xl mx-auto">
      <slot />
    </main>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
