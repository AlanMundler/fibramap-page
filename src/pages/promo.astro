---
import Layout from '../layouts/Layout.astro';
import DisqusComments from '../components/DisqusComments.jsx';
---

<Layout title="FibraMap - Promociones">
  <div class="space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold">Promociones</h1>
      <p class="text-gray-400 max-w-2xl">
        Si te enteraste de una promo, compartila acá así otros pueden aprovecharla.
      </p>
    </div>
    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
      <DisqusComments client:load identifier="promo" title="Promociones FibraMap" />
    </div>
  </div>
</Layout>
