---
import Layout from '../layouts/Layout.astro';
import { servicios, fmt } from '../data/servicios';

const personal = servicios.filter(s => s.proveedor === 'Personal Fibra');
const claro = servicios.filter(s => s.proveedor === 'Claro');
const iplan = servicios.filter(s => s.proveedor === 'IPLAN');
const icba = servicios.filter(s => s.proveedor === 'Internet Córdoba');
const batcom = servicios.filter(s => s.proveedor === 'Batcom');
const guabi = servicios.filter(s => s.proveedor === 'Guabi');
const trimotion = servicios.filter(s => s.proveedor === 'Trimotion');
---

<Layout title="FibraMap - Promociones">
  <div class="space-y-6 max-w-4xl mx-auto">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Promociones Agosto 2026</h1>
      <p class="text-gray-400 max-w-2xl">
        Todas las promos vigentes de proveedores de fibra óptica en Córdoba Capital. Precios verificados al 18/08/2026.
      </p>
    </div>

    <section class="space-y-4">
      <!-- Claro -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-red-400">Claro</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-red-500/15 text-red-300 border border-red-500/30">{claro[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">70% de descuento los primeros 5 meses + 1 mes gratis. Instalación bonificada.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {claro.map(s => (
            <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
              <div class="text-[10px] sm:text-xs text-gray-400">{s.plan}</div>
              <div class="text-lg sm:text-xl font-bold">{fmt(s.precioDesc)}<span class="text-xs font-normal text-gray-400">/mes</span></div>
              <div class="text-[10px] text-gray-500 line-through">{fmt(s.precioLista)}</div>
            </div>
          ))}
        </div>
        <p class="text-[10px] sm:text-xs text-gray-500">Simétrico. 64+ barrios. Incluye: Disney+ Premium 1 mes, Prime Video 1 mes, 4000 min llamadas.</p>
      </div>

      <!-- Personal Fibra -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-blue-400">Personal Fibra</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-blue-500/15 text-blue-300 border border-blue-500/30">{personal[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">Descuento los primeros 6 meses. Instalación sin costo.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {personal.map(s => (
            <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
              <div class="text-[10px] sm:text-xs text-gray-400">{s.plan}</div>
              <div class="text-lg sm:text-xl font-bold">{fmt(s.precioDesc)}<span class="text-xs font-normal text-gray-400">/mes</span></div>
              <div class="text-[10px] text-gray-500 line-through">{fmt(s.precioLista)}</div>
            </div>
          ))}
        </div>
        <p class="text-[10px] sm:text-xs text-gray-500">Asimétrico (subida menor). Flow Full: 150+ canales, series, pelis, deportes.</p>
      </div>

      <!-- IPLAN -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-green-400">IPLAN</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-green-500/15 text-green-300 border border-green-500/30">{iplan[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">44% de descuento los primeros 12 meses. Fibra 100% simétrica. Solo Córdoba Centro.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {iplan.map(s => (
            <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
              <div class="text-[10px] sm:text-xs text-gray-400">{s.plan} Simétrico</div>
              <div class="text-lg sm:text-xl font-bold">Consultar</div>
              <div class="text-[10px] text-green-400">{s.atencionCl}</div>
            </div>
          ))}
        </div>
        <p class="text-[10px] sm:text-xs text-gray-500">WiFi 6 incluido. Sin permanencia. Primer mes bonificado.</p>
      </div>

      <!-- Internet Córdoba -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-yellow-400">Internet Córdoba</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-yellow-500/15 text-yellow-300 border border-yellow-500/30">{icba[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">Sin promos temporales. Precio fijo permanente. 67 barrios. WiFi incluido.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {icba.map(s => (
            <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
              <div class="text-[10px] sm:text-xs text-gray-400">{s.plan}</div>
              <div class="text-lg sm:text-xl font-bold">{fmt(s.precioDesc)}<span class="text-xs font-normal text-gray-400">/mes</span></div>
            </div>
          ))}
        </div>
        <p class="text-[10px] sm:text-xs text-gray-500">Sin sorpresas en la factura. Soporte 24/7 vía WhatsApp.</p>
      </div>

      <!-- Batcom -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-purple-400">Batcom</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30">{batcom[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">20% OFF los primeros 12 meses + 1er mes bonificado. WiFi de cortesía.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3">
          {batcom.map(s => (
            <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
              <div class="text-[10px] sm:text-xs text-gray-400">{s.plan}</div>
              <div class="text-lg sm:text-xl font-bold">{fmt(s.precioDesc)}<span class="text-xs font-normal text-gray-400">/mes</span></div>
              <div class="text-[10px] text-gray-500 line-through">{fmt(s.precioLista)}</div>
            </div>
          ))}
        </div>
        <p class="text-[10px] sm:text-xs text-gray-500">Equipos comodato. 50+ barrios norte y noroeste.</p>
      </div>

      <!-- Guabi -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-cyan-400">Guabi</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">{guabi[0]?.descuento}</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">35% OFF los primeros 6 meses. Zona Sur exclusivamente.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Planes Standard</div>
            <div class="space-y-1.5 mt-1.5">
              {guabi.map(s => (
                <div class="flex justify-between text-xs sm:text-sm"><span>{s.plan}</span><span class="font-bold">{fmt(s.precioDesc)}</span></div>
              ))}
            </div>
          </div>
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Sin permanencia. TV opcional con Gigared o DGO.</div>
          </div>
        </div>
      </div>

      <!-- Trimotion -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-orange-400">Trimotion</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-300 border border-orange-500/30">Agosto 2026</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">Precios julio 2026. Precio agosto NO CONFIRMADO. Verificar vigencia.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Solo Internet</div>
            <div class="space-y-1.5 mt-1.5">
              {trimotion.map(s => (
                <div class="flex justify-between text-xs sm:text-sm"><span>{s.plan}</span><span class="font-bold">{fmt(s.precioDesc)}</span></div>
              ))}
            </div>
          </div>
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Instalación: $70.000</div>
            <div class="text-[10px] text-gray-500 mt-1.5">Verificar precios agosto antes de contratar.</div>
          </div>
        </div>
      </div>

      <!-- Krillcom -->
      <div class="bg-gray-800/80 rounded-xl border border-gray-700/50 p-4 sm:p-5 space-y-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-gray-400">Krillcom</h2>
          <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-gray-700/50 text-gray-300 border border-gray-600/50">Inalámbrico</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-400">Solo inalámbrico (no fibra óptica). 50% OFF en instalación.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Internet</div>
            <div class="space-y-1.5 mt-1.5">
              {servicios.filter(s => s.proveedor === 'Krillcom').map(s => (
                <div class="flex justify-between text-xs sm:text-sm"><span>{s.plan}</span><span class="font-bold">{fmt(s.precioDesc)}</span></div>
              ))}
            </div>
          </div>
          <div class="bg-gray-700/30 border border-gray-600/30 rounded-lg p-3">
            <div class="text-[10px] sm:text-xs text-gray-400">Cobertura: barrios periféricos</div>
            <div class="text-[10px] text-gray-500 mt-1.5">Instalación: $70.000. Router Wi-Fi: $75.000 aparte.</div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-gray-700 pt-4">
      <p class="text-xs text-gray-500">
        Precios verificados al 18/08/2026. Los descuentos aplican solo para clientes nuevos. 
        Después del periodo de descuento, los precios vuelven a valor de lista.
      </p>
    </div>
  </div>
</Layout>
