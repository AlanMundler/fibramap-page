---
import Layout from '../layouts/Layout.astro';
import ChatBot from '../components/ChatBot.jsx';
---

<Layout title="FibraMap">
  <div class="space-y-8 max-w-2xl mx-auto">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Inicio</h1>
      <p class="text-gray-400 max-w-2xl leading-relaxed">
        Bienvenido a FibraMap. Acá podes ver si la fibra óptica llega a tu zona en Córdoba, qué proveedores la ofrecen y qué planes tienen. También podés dejar tu opinión sobre el servicio que contratás.
      </p>
    </div>
    <ChatBot client:load />
  </div>
</Layout>
