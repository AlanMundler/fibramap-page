---
import Layout from '../layouts/Layout.astro';
import CompareIsland from '../components/CompareIsland.jsx';
---

<Layout
  title="FibraMap — Comparar planes de fibra óptica"
  description="Compará hasta 3 planes de fibra óptica lado a lado. Velocidad, precio, cobertura y descuento entre Claro, Personal, IPLAN, Internet Córdoba, Batcom y Guabi."
>
  <div class="space-y-6 max-w-4xl mx-auto">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Comparar Servicios</h1>
      <p class="text-gray-400 max-w-2xl">
        Elegí dos o tres planes para ver las diferencias lado a lado.
      </p>
    </div>
    <CompareIsland client:load />
  </div>
</Layout>
