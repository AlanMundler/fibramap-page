---
import Layout from '../layouts/Layout.astro';
import SpeedLeaderboard from '../components/SpeedLeaderboard.jsx';
---

<Layout
  title="FibraMap — Leaderboard de velocidad de fibra óptica"
  description="Resultados crowdsourceados de velocidad por proveedor y barrio en Córdoba Capital. Descarga, subida y latencia reales."
>
  <div class="space-y-6 max-w-4xl mx-auto">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Leaderboard de Velocidad</h1>
      <p class="text-gray-400 max-w-2xl">
        Resultados crowdsourceados de velocidad por proveedor y barrio en Córdoba Capital.
        Hacé click en una columna para ordenar, o filtrá por proveedor.
      </p>
    </div>
    <SpeedLeaderboard client:load />
  </div>
</Layout>
