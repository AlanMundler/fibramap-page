---
import Layout from '../layouts/Layout.astro';
import BlogIsland from '../components/BlogIsland.jsx';
---

<Layout
  title="FibraMap — Noticias del mercado de fibra óptica"
  description="Noticias del mercado de fibra óptica e internet en Argentina. Regulaciones, comparativas y novedades del sector telecomunicaciones."
>
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="space-y-1">
      <h1 class="text-2xl sm:text-3xl font-bold">Noticias</h1>
      <p class="text-gray-400 text-sm sm:text-base">
        Noticias del mercado de fibra óptica e internet en Argentina.
      </p>
    </div>
    <BlogIsland client:load />
  </div>
</Layout>
