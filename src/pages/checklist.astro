---
import Layout from '../layouts/Layout.astro';

const preguntas = [
  '¿El precio incluye IVA?',
  '¿Hay permanencia? ¿Cuántos meses?',
  '¿La velocidad es simétrica?',
  '¿El router está incluido o es comodato?',
  '¿Hay costo de instalación?',
  '¿Qué pasa si quiero darme de baja?',
  '¿El precio es fijo o puede cambiar?',
  '¿Hay límite de descarga (tope de datos)?',
  '¿Incluye línea fija o celular?',
  '¿Qué soporte ofrecen (horario, canal)?',
];

const redFlags = [
  'Te presionan para firmar rápido "porque la promo vence hoy"',
  'No te dan el contrato por escrito antes de instalar',
  'El precio en la publicidad es distinto al que te dicen por teléfono',
  'Te cobran "instalación" que no estaba en la oferta inicial',
  'La velocidad prometida es "hasta" y no la real',
  'No podés hablar con una persona en soporte, solo bots',
  'El servicio de baja tiene múltiples pasos o plazos largos',
];

const tips = [
  'Pedí el desglose de costos por escrito: mensualidad, instalación, equipamiento.',
  'Comprobá reseñas de tu barrio específico, no solo de la empresa en general.',
  'Si podés elegir sin permanencia, es mejor para probar.',
  'Preguntá si hay un período de prueba para cancelar sin costo.',
  'Usá las comparativas de FibraMap para ver opciones disponibles en tu zona.',
  'Reclamá en ENACOM si no resuelven tu problema. Guardá ticket de atención.',
  'Compartí tu experiencia: ayudás a otros a elegir mejor.',
];
---

<Layout
  title="FibraMap — Checklist de contratación de fibra óptica"
  description="Checklist imprimible con 10 preguntas clave, red flags y tips para ahorrar antes de contratar fibra óptica en Córdoba Capital."
>
  <div class="max-w-4xl mx-auto space-y-8 print:space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold">Checklist de Contratación</h1>
        <p class="text-gray-400">Antes de contratar fibra óptica, hacete estas preguntas.</p>
      </div>
      <button
        onclick="window.print()"
        class="bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors print:hidden"
      >
        Imprimir checklist
      </button>
    </div>

    <section class="bg-gray-800/80 border border-gray-700/50 rounded-xl p-4 sm:p-5 space-y-4">
      <h2 class="text-lg sm:text-xl font-semibold">Qué preguntar antes de contratar</h2>
      <ul class="space-y-3">
        {preguntas.map((p) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex-shrink-0 w-5 h-5 border-2 border-gray-500 rounded print:border-gray-400"></span>
            <span class="text-gray-300 text-sm sm:text-base leading-relaxed">{p}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-gray-800/80 border border-red-700/30 rounded-xl p-4 sm:p-5 space-y-4">
      <h2 class="text-lg sm:text-xl font-semibold text-red-400">Señales de alerta (red flags)</h2>
      <ul class="space-y-3">
        {redFlags.map((r) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 text-red-400 flex-shrink-0">⚠</span>
            <span class="text-gray-300 text-sm sm:text-base leading-relaxed">{r}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-gray-800/80 border border-green-700/30 rounded-xl p-4 sm:p-5 space-y-4">
      <h2 class="text-lg sm:text-xl font-semibold text-green-400">Tips para ahorrar</h2>
      <ul class="space-y-3">
        {tips.map((t) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 text-green-400 flex-shrink-0">✓</span>
            <span class="text-gray-300 text-sm sm:text-base leading-relaxed">{t}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="text-gray-500 text-xs text-center print:text-gray-400">
      FibraMap — Checklist para contratar fibra óptica en Córdoba
    </p>
  </div>
</Layout>

<style>
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    nav, footer, .print\:hidden, button {
      display: none !important;
    }
    .bg-gray-800\/80 {
      background: white !important;
      border-color: #ccc !important;
    }
    .text-gray-100,
    .text-gray-300,
    .text-gray-400,
    .text-gray-500 {
      color: black !important;
    }
    .text-red-400 { color: #c00 !important; }
    .text-green-400 { color: #060 !important; }
    h1, h2 {
      color: black !important;
    }
  }
</style>
