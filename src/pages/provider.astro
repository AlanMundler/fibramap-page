---
import Layout from '../layouts/Layout.astro';
import TaskCard from '../components/TaskCard.astro';
import { servicios, proveedores } from '../data/servicios';

const serviciosDisplay = servicios.map(s => ({
  ...s,
  velocidad: `${s.download} Mbps`,
  velocidadSub: s.upload,
  velocidadBaj: `${s.download} Mbps`,
  ip: s.proveedor === 'IPLAN' ? 'CG-NAT (verificar)' : 'Dinámica',
  instalacion: s.instalacion > 0 ? `$${s.instalacion.toLocaleString('es-AR')}` : '$0',
  precioLista: s.precioLista > 0 ? `$${s.precioLista.toLocaleString('es-AR')}` : (s.precioDesc === 0 ? 'Consultar' : ''),
  precioDesc: s.precioDesc > 0 ? `$${s.precioDesc.toLocaleString('es-AR')}` : 'Consultar',
  precioDetalle: [s.descuento, s.detalle].filter(Boolean).join('. '),
}));
---

<Layout
  title="FibraMap — Planes y precios de fibra óptica Córdoba"
  description="Todos los planes de fibra óptica disponibles en Córdoba Capital: Claro, Personal, IPLAN, Internet Córdoba, Batcom y Guabi. Precios verificados agosto 2026."
>
  <div class="space-y-8">
    <div>
      <h1 class="text-xl sm:text-2xl font-semibold">Proveedores FTTH en Córdoba Capital</h1>
      <p class="text-sm text-gray-400 mt-1">Investigación verificada al 18/08/2026. La cobertura real depende de la dirección exacta.</p>
    </div>

    {proveedores.map(proveedor => (
      <section key={proveedor}>
        <h2 class="text-lg font-semibold mb-3">{proveedor}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 sm:gap-4 items-stretch">
          {serviciosDisplay.filter(s => s.proveedor === proveedor).map(s => (
            <TaskCard key={s.id} servicio={s} />
          ))}
        </div>
      </section>
    ))}

    <div class="border-t border-gray-700 pt-6 space-y-3">
      <h2 class="text-lg font-semibold">No confirmados como FTTH en Córdoba Capital</h2>
      <p class="text-sm text-gray-400">Los siguientes proveedores no se encontraron con FTTH residencial activo en Córdoba Capital al 18/08/2026:</p>
      <ul class="text-sm text-gray-400 list-disc list-inside space-y-1">
        <li><strong class="text-gray-300">Movistar</strong> — no se encontró FTTH residencial activo en Córdoba Capital</li>
        <li><strong class="text-gray-300">Telecentro</strong> — sin cobertura en Córdoba Capital (solo CABA/GBA)</li>
        <li><strong class="text-gray-300">Iptel</strong> — FTTH confirmado solo en Villa Allende / Mendiolaza</li>
        <li><strong class="text-gray-300">Integral Comunicaciones</strong> — FTTH en Punilla, no en Córdoba Capital</li>
        <li><strong class="text-gray-300">Wisp-CBA</strong> — conexión inalámbrica (antena), no FTTH</li>
      </ul>
    </div>
  </div>
</Layout>
