const proveedores = ['Claro', 'Personal', 'Iplan', 'Movistar', 'Internet Córdoba'];
---

<Layout title="FibraMap - Proveedores">
  <div class="space-y-8">
    <div>
      <h1 class="text-xl font-semibold">Proveedores de fibra óptica en Córdoba</h1>
      <p class="text-sm text-gray-400 mt-1">Precios julio 2026. Verificá cobertura en la página de cada proveedor.</p>
    </div>

    {proveedores.map(proveedor => (
      <section>
        <h2 class="text-lg font-semibold mb-3">{proveedor}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {servicios.filter(s => s.proveedor === proveedor).map(s => (
            <TaskCard servicio={s} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
