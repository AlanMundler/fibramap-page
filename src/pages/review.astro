---
import Layout from '../layouts/Layout.astro';
import DisqusComments from '../components/DisqusComments.jsx';
const base = '/fibramap-page';
---

<Layout title="FibraMap - Opiniones">
  <div class="px-4 space-y-4">
    <h1 class="text-xl font-semibold">Opiniones</h1>
    <p class="dark:text-gray-300 max-w-2xl">
      Contanos sobre tu experiencia con el servicio: qué bien, qué mal, qué se podría mejorar.
    </p>
    <div class="flex gap-2 flex-wrap">
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200">Claro</a>
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200">Personal</a>
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-200">Iplan</a>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
      <DisqusComments client:load />
    </div>
  </div>
</Layout>
