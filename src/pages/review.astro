---
import Layout from '../layouts/Layout.astro';
import DisqusComments from '../components/DisqusComments.jsx';
const base = '/fibramap-page';
---

<Layout title="FibraMap - Opiniones">
  <div class="space-y-6">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl font-bold">Opiniones</h1>
      <p class="text-gray-400 max-w-2xl">
        Contanos sobre tu experiencia con el servicio: qué bien, qué mal, qué se podría mejorar.
      </p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-red-900/50 text-red-300 hover:bg-red-900 transition-colors">Claro</a>
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-blue-900/50 text-blue-300 hover:bg-blue-900 transition-colors">Personal</a>
      <a href={base + '/review'} class="px-4 py-2 text-sm font-medium rounded-lg bg-pink-900/50 text-pink-300 hover:bg-pink-900 transition-colors">Iplan</a>
    </div>
    <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
      <DisqusComments client:load />
    </div>
  </div>
</Layout>
