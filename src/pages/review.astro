---
import Layout from '../layouts/Layout.astro';
import Giscus from '../components/Giscus.astro';
import ReviewSystem from '../components/ReviewSystem';
---

<Layout
  title="FibraMap — Opiniones y calificaciones de proveedores"
  description="Opiniones de proveedores de fibra óptica en Córdoba. Análisis de sentimiento de 10 fuentes independientes: Reddit, Trustpilot, Google Reviews y más."
>
  <div class="space-y-6 max-w-4xl mx-auto">
    <ReviewSystem client:load />

    <div class="bg-gray-800/80 rounded-xl p-4 sm:p-5 border border-gray-700/50 backdrop-blur-sm">
      <h2 class="text-lg font-semibold mb-3">Dejanos tu opinion</h2>
      <Giscus />
    </div>
  </div>
</Layout>
