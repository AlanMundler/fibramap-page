---
import Layout from '../layouts/Layout.astro';
import MapIsland from '../components/MapIsland.jsx';
---

<Layout title="FibraMap - Mapa">
  <div class="space-y-6">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold">Mapa de cobertura</h1>
      <p class="text-gray-400 max-w-2xl">
        Barrios con fibra óptica confirmada. Hacé click en un marcador para ver qué proveedores lo cubren.
      </p>
    </div>
    <MapIsland client:only="react" />
    <p class="text-xs text-gray-500">
      La cobertura puede variar block a block. Verificá tu dirección en la página de cada proveedor.
    </p>
  </div>
</Layout>
