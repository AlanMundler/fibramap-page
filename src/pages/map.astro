---
import Layout from '../layouts/Layout.astro';
import MapIsland from '../components/MapIsland.jsx';
import BarrioSearch from '../components/BarrioSearch.jsx';
---

<Layout
  title="FibraMap — Mapa de cobertura FTTH Córdoba"
  description="Mapa interactivo de cobertura de fibra óptica en Córdoba Capital. Buscá tu barrio y conocé qué proveedores llegan."
>
  <div class="space-y-6">
    <div class="space-y-2 mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Mapa de cobertura</h1>
      <p class="text-gray-400 max-w-2xl">
        Buscá tu barrio o hacé click en el mapa para ver qué proveedores lo cubren.
      </p>
    </div>
    <div class="relative z-20">
      <BarrioSearch client:load />
    </div>
    <MapIsland client:only="react" />
    <p class="text-[10px] sm:text-xs text-gray-500">
      La cobertura puede variar block a block. Verificá tu dirección en la página de cada proveedor.
    </p>
  </div>
</Layout>
