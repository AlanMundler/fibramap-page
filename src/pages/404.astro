---
import Layout from '../layouts/Layout.astro';
const base = '/fibramap-page';
---

<Layout title="FibraMap - 404">
  <div class="flex flex-col items-center justify-center py-20 space-y-4">
    <div class="text-6xl font-bold text-gray-700">404</div>
    <h1 class="text-xl font-semibold text-gray-300">Página no encontrada</h1>
    <p class="text-gray-500 text-sm">La página que buscás no existe o fue movida.</p>
    <a href={base + '/'} class="btn-primary mt-4">Volver al inicio</a>
  </div>
</Layout>
